# apps/web/.env.example
# Astro public env vars must be PUBLIC_-prefixed to be exposed to the client.
# Server-only vars (no prefix) stay server-side.

PUBLIC_API_URL=http://localhost:3000

# Authentik's public origin — used by the NavAccountMenu "Engineering Deck"
# link. Defaults to https://auth.aiqadam.org (prod) when unset.
PUBLIC_AUTHENTIK_URL=
