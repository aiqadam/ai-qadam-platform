# apps/web-next/.env.example
# Copy to apps/web-next/.env and edit.

# Telegram Login Widget bot @handle (NOT the secret bot token).
# The bot username is public — it is the @handle users see in Telegram.
# Set this to enable the "Sign in with Telegram" button on /auth/sign-in.
# Leave blank to hide the Telegram sign-in option (safe default for local dev
# without a registered bot).
TELEGRAM_BOT_USERNAME=

# Authentik's public origin — used client-side by the AccountChip
# "Engineering Deck" link. Defaults to https://auth.aiqadam.org (prod) when
# unset; QA sets this to https://auth.qa.aiqadam.org (see
# deploy/docker-compose.qa.yml). Astro/Vite convention: must be PUBLIC_-
# prefixed to be exposed to the client.
PUBLIC_AUTHENTIK_URL=
